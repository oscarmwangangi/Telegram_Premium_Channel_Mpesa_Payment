# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Database (PostgreSQL / Prisma)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/telegram_subscriptions?schema=public"
# Prisma needs a separate shadow DB permission to run `migrate dev` locally;
# it creates/drops this automatically if the DB user has CREATEDB rights.
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/telegram_subscriptions_shadow?schema=public"

# ---------------------------------------------------------------------------
# Auth (Admin JWT)
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_DOMAIN=localhost

# Optional: bootstrap one SUPER_ADMIN account on `npx prisma db seed`.
# Leave unset to skip — never ships with a default admin password.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
BOT_TOKEN=
CHANNEL_ID=          # numeric chat id of the private channel, e.g. -1001234567890
CHANNEL_USERNAME=    # e.g. @your_premium_channel (used only for display)
CHANNEL_NAME=

# ---------------------------------------------------------------------------
# M-Pesa (Daraja)
# ---------------------------------------------------------------------------
MPESA_ENV=sandbox               # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-public-domain/api/payments/mpesa/callback

# ---------------------------------------------------------------------------
# PayPal
# ---------------------------------------------------------------------------
PAYPAL_ENV=sandbox               # sandbox | live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ---------------------------------------------------------------------------
# Exchange Rate API
# ---------------------------------------------------------------------------
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/USD
EXCHANGE_RATE_CACHE_TTL_MINUTES=60

# ---------------------------------------------------------------------------
# Email (Nodemailer / SMTP)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Premium Channel <no-reply@yourdomain.com>"

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
CORS_ALLOWED_ORIGINS=http://localhost:5173
